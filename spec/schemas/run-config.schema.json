{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mines-of-morja/UnitcellMD/blob/main/spec/schemas/run-config.schema.json",
  "title": "UnitcellMD run configuration run.toml (spec 0.1), applied to the parsed TOML document",
  "description": "Normative prose: spec/run-config.md. Provider-specific keys are validated by the providers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_version", "system", "run", "providers"],
  "properties": {
    "spec_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "system": { "$ref": "#/$defs/relpath" },
    "title": { "type": "string" },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integrator", "timestep_fs", "steps", "seed"],
      "properties": {
        "integrator": { "enum": ["velocity-verlet", "langevin-baoab"] },
        "timestep_fs": { "type": "number", "exclusiveMinimum": 0 },
        "steps": { "type": "integer", "minimum": 0 },
        "seed": { "type": "integer", "minimum": 0 }
      }
    },
    "velocities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generate", "temperature_K"],
      "properties": {
        "generate": { "enum": ["maxwell-boltzmann"] },
        "temperature_K": { "type": "number", "minimum": 0 }
      }
    },
    "momentum": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "remove_com_every": { "type": "integer", "minimum": 0 },
        "remove_angular": { "type": "boolean" }
      }
    },
    "thermostat": {
      "type": "object",
      "required": ["kind"],
      "properties": { "kind": { "enum": ["csvr", "nose-hoover-chain", "langevin"] } },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "csvr" } } },
          "then": {
            "additionalProperties": false,
            "required": ["kind", "temperature_K", "tau_ps"],
            "properties": {
              "kind": true,
              "temperature_K": { "type": "number", "exclusiveMinimum": 0 },
              "tau_ps": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "nose-hoover-chain" } } },
          "then": {
            "additionalProperties": false,
            "required": ["kind", "temperature_K", "tau_ps"],
            "properties": {
              "kind": true,
              "temperature_K": { "type": "number", "exclusiveMinimum": 0 },
              "tau_ps": { "type": "number", "exclusiveMinimum": 0 },
              "chain_length": { "type": "integer", "minimum": 1, "maximum": 10 }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "langevin" } } },
          "then": {
            "additionalProperties": false,
            "required": ["kind", "temperature_K", "friction_per_ps"],
            "properties": {
              "kind": true,
              "temperature_K": { "type": "number", "exclusiveMinimum": 0 },
              "friction_per_ps": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      ]
    },
    "barostat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "pressure_bar", "tau_ps", "compressibility_per_bar"],
      "properties": {
        "kind": { "enum": ["c-rescale"] },
        "pressure_bar": { "type": "number" },
        "tau_ps": { "type": "number", "exclusiveMinimum": 0 },
        "compressibility_per_bar": { "type": "number", "exclusiveMinimum": 0 },
        "every": { "type": "integer", "minimum": 1 },
        "coupling": { "enum": ["isotropic", "anisotropic"] }
      }
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directory": { "$ref": "#/$defs/relpath" },
        "trajectory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "every"],
          "properties": {
            "file": { "$ref": "#/$defs/relpath" },
            "every": { "type": "integer", "minimum": 1 },
            "velocities": { "type": "boolean" },
            "forces": { "type": "boolean" },
            "precision": { "enum": ["float64", "float32"] }
          }
        },
        "thermo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "every"],
          "properties": {
            "file": { "$ref": "#/$defs/relpath" },
            "every": { "type": "integer", "minimum": 1 }
          }
        },
        "checkpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "every"],
          "properties": {
            "file": { "$ref": "#/$defs/relpath" },
            "every": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  },
  "$defs": {
    "relpath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/~]",
      "description": "Relative path (no leading '/' or '~'); resolved against the directory of run.toml."
    }
  }
}
